{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "76rem"
		},
		"background": {
			"backgroundImage": false
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": true,
			"palette": [
				{
					"color": "#FAF7F2",
					"name": "Paper",
					"slug": "base"
				},
				{
					"color": "#F0EBE1",
					"name": "Panel",
					"slug": "surface"
				},
				{
					"color": "#1A1613",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#57504A",
					"name": "Annotation",
					"slug": "muted"
				},
				{
					"color": "#8C2F26",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#C4B7A2",
					"name": "Rule",
					"slug": "rule"
				}
			]
		},
		"dimensions": {
			"minHeight": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.5rem",
					"slug": "10"
				},
				{
					"name": "2",
					"size": "1rem",
					"slug": "20"
				},
				{
					"name": "3",
					"size": "1.5rem",
					"slug": "30"
				},
				{
					"name": "4",
					"size": "2rem",
					"slug": "40"
				},
				{
					"name": "5",
					"size": "3rem",
					"slug": "50"
				},
				{
					"name": "6",
					"size": "4rem",
					"slug": "60"
				},
				{
					"name": "7",
					"size": "6rem",
					"slug": "70"
				},
				{
					"name": "8",
					"size": "8rem",
					"slug": "80"
				}
			]
		},
