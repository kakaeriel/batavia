	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0",
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|accent"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.01em",
					"lineHeight": "1.2"
				},
				":hover": {
					"border": {
						"color": "var:preset|color|ink"
					},
					"color": {
						"background": "var:preset|color|ink",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"border": {
						"color": "var:preset|color|ink"
					},
					"color": {
						"background": "var:preset|color|ink",
						"text": "var:preset|color|base"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|ink",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"lineHeight": "1.5"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.012em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xxx-large",
					"letterSpacing": "-0.028em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"letterSpacing": "-0.022em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"h6": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				},
				":focus": {
					"color": {
						"text": "var:preset|color|ink"
					}
				}
			}
		},
		"blocks": {
			"core/code": {
				"border": {
					"color": "var:preset|color|rule",
					"radius": "0",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|ink"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|30",
						"right": "var:preset|spacing|30"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.7"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.04em"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.04em"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|ink"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|30",
						"right": "var:preset|spacing|30"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.7"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|rule",
					"style": "solid",
					"width": "1px 0"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "normal",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "normal",
					"lineHeight": "1.5"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|rule"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.02em",
					"textTransform": "none"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|ink"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "400",
					"letterSpacing": "0.04em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							},
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|ink"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							},
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.04em"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
