			"fontSizes": [
				{
					"name": "Footnote",
					"size": "0.75rem",
					"slug": "x-small"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Body",
					"size": "1.0625rem",
					"slug": "medium"
				},
				{
					"name": "Lead",
					"size": "1.25rem",
					"slug": "large",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "Subhead",
					"size": "1.75rem",
					"slug": "x-large",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"name": "Head",
					"size": "2.5rem",
					"slug": "xx-large",
